{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labforge.example/schemas/lab_profile.schema.json",
  "title": "LabForge Profile Document",
  "type": "object",
  "required": ["name", "variables"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 3
    },
    "description": {
      "type": "string",
      "minLength": 5
    },
    "variables": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "boolean"]
      }
    }
  }
}
