{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labforge.example/schemas/lab_spec.schema.json",
  "title": "LabForge Lab Specification",
  "type": "object",
  "required": ["name", "nodes", "links"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,62}$",
      "description": "Containerlab-safe lab name."
    },
    "description": {
      "type": "string",
      "minLength": 8
    },
    "api_version": {
      "type": "string",
      "default": "1.0"
    },
    "variables": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "integer", "boolean"]
      },
      "description": "Optional template variables merged with profile variables."
    },
    "nodes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/node"
      }
    },
    "links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/link"
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["kind", "image"],
      "additionalProperties": true,
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 2
        },
        "image": {
          "type": "string",
          "minLength": 3
        },
        "mgmt_ipv4": {
          "type": "string"
        },
        "startup_config": {
          "type": "string"
        },
        "binds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean"]
          }
        }
      }
    },
    "link": {
      "type": "object",
      "required": ["endpoints"],
      "additionalProperties": true,
      "properties": {
        "endpoints": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*:[A-Za-z0-9-]+$"
          }
        }
      }
    }
  }
}
